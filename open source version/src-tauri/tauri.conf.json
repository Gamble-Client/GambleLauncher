{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gamble Client Launcher",
  "version": "0.1.78",
  "identifier": "store.gamble-client.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gamble Client Launcher",
        "width": 1120,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "deb", "appimage", "nsis", "msi"],
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Gamble Client Launcher",
    "longDescription": "Native launcher for Gamble Client installs, updates, profiles, logs, and account sign-in.",
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    }
  }
}
